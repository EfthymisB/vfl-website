<footer class="site-footer">
  <div class="wrap site-footer__grid">
    <div>
      <a class="brand" href="/" style="margin-bottom:1rem">
        <img class="brand__mark" src="/assets/img/logo.svg" alt="" width="34" height="34" decoding="async">
        <span class="brand__text"><span class="brand__name">{{ site.shortName }}</span></span>
      </a>
      <p class="site-footer__blurb">{{ site.description }}</p>
      <p style="margin-top:1rem"><a href="mailto:{{ site.email }}" class="mono" style="letter-spacing:.06em;text-transform:none">{{ site.email }}</a></p>
    </div>

    <div>
      <h4>The league</h4>
      <ul>
        {% for item in nav %}
        <li><a href="{{ item.url }}">{{ item.text }}</a></li>
        {% endfor %}
        <li><a href="/rules/">Rules and venues</a></li>
        <li><a href="/free-agents/">Free agents</a></li>
        <li><a href="/portal/">Team portal</a></li>
        <li><a href="/sponsors/">Sponsors</a></li>
      </ul>
    </div>

    <div>
      <h4>Elsewhere</h4>
      <ul>
        <li><a href="{{ site.social.instagram }}" rel="me noopener" target="_blank" data-umami-event="Social link" data-umami-event-network="Instagram">Instagram</a></li>
        <li><a href="{{ site.social.linkedin }}" rel="me noopener" target="_blank" data-umami-event="Social link" data-umami-event-network="LinkedIn">LinkedIn</a></li>
        <li><a href="{{ site.social.sofascore }}" rel="noopener" target="_blank" data-umami-event="Social link" data-umami-event-network="Sofascore">Sofascore</a></li>
        <li><a href="/feed.xml">RSS feed</a></li>
        <li><a href="/privacy/">Privacy</a></li>
      </ul>
    </div>
  </div>

  {% if sponsors.list | length %}
  <div class="wrap site-footer__sponsors">
    <h4>Supported by</h4>
    {% set sponsorWhere = "footer" %}
    {% include "partials/sponsor-logos.njk" %}
  </div>
  {% endif %}

  <div class="wrap">
    <div class="site-footer__legal">
      <span>© <span data-year>{{ site.currentSeason }}</span> {{ site.name }}</span>
      <span>Live data by Sofascore</span>
      <span>Made in {{ site.city }}, between renders</span>
    </div>
    <p class="site-footer__note">Team names and logos belong to their studios and are used only to identify the teams. The {{ site.shortName }} is run by volunteers and isn't affiliated with or endorsed by any studio.</p>
  </div>
</footer>
